# Copy to .env and adjust.
PORT=4000
NODE_ENV=development

# MySQL / MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rbac_elearning

# Account used only by `npm run db:setup` to create the database, procedures and app account.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# Least-privilege account the application runs as (created by db:setup).
# The setup script generates a random password. If you imported db/rbac_elearning.sql
# with phpMyAdmin instead, use the password written at the top of that file.
DB_USER=elearn_app
DB_PASSWORD=change-me-app-db-password

# Long random string used to sign JWTs (HS256). CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30m

# bcrypt cost factor (Section 4.4.2)
BCRYPT_COST=12

# Optional HTTPS: paths to a certificate and key. When set, the server listens over HTTPS.
TLS_CERT=
TLS_KEY=

# Behind a reverse proxy (nginx), set to 1 so req.ip is the client address.
TRUST_PROXY=0

# --- Only needed for a hosted database (e.g. Aiven, PlanetScale) or on Vercel ---
# `npm run vercel:setup` fills these in for you; see VERCEL_DEPLOY.md.

# Require an encrypted connection to MySQL. Set to "true", or leave DB_SSL_CA(_FILE) set
# instead, which implies it.
DB_SSL=

# The hosting provider's CA certificate, so the connection can be verified. Either the
# PEM text itself (e.g. with real newlines or "\n"), or that text base64-encoded.
DB_SSL_CA=
# ...or a path to a .pem file, relative to the F4 folder.
DB_SSL_CA_FILE=

# Where uploaded materials and submissions are kept: "disk" (default off Vercel) or
# "database" (default on Vercel, where the filesystem is not persistent).
FILE_STORAGE=
MAX_UPLOAD_MB=10
