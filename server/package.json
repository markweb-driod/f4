{
  "name": "secure-elearning-rbac-server",
  "version": "1.0.0",
  "description": "Secure e-learning system using Role-Based Access Control (RBAC96) for tertiary institutions - API server",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node db/setup.js",
    "db:reset": "node db/setup.js --reset",
    "db:export": "node db/export-sql.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}
